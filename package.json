{
  "name": "art-widgets",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev apps/playground",
    "build": "nuxt build apps/playground",
    "generate": "nuxt generate apps/playground",
    "preview": "nuxt preview apps/playground",
    "postinstall": "nuxt prepare apps/playground",
    "typecheck": "vue-tsc --noEmit && nuxt typecheck apps/playground",
    "geo:build": "node tools/geo/build.mjs",
    "geo:polities": "node --max-old-space-size=6144 tools/geo/polities.mjs",
    "reel:dev": "nuxt dev apps/reel",
    "reel:render": "node tools/reel/render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@vueuse/core": "^11.1.0",
    "d3-geo": "^3.1.1",
    "gsap": "^3.12.5",
    "nuxt": "^3.13.1",
    "vue": "^3.5.3",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "d3-contour": "^4.0.2",
