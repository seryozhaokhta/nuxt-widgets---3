{
  // Type-checks the mechanics in packages/*. The playground has its own
  // tsconfig generated by Nuxt (apps/playground/tsconfig.json).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@art-widgets/*": ["./packages/*/src"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.vue"]
}
